---
/**
 * A static terminal window. Each line is plain text with a tone:
 * cmd (what you type), ok, fail, fix, dim, or plain.
 */
interface Props {
	title?: string;
	lines: { text: string; tone?: 'cmd' | 'ok' | 'fail' | 'fix' | 'dim' | 'plain' }[];
}
const { title = 'Terminal', lines } = Astro.props;
---

<figure class="kf-term" aria-label={title}>
	<div class="kf-term-bar" aria-hidden="true">
		<span></span><span></span><span></span>
		<em>{title}</em>
	</div>
	<pre><code>{lines.map((line) => (
		<span class={`kf-${line.tone ?? 'plain'}`}>{line.tone === 'cmd' && <b aria-hidden="true">$ </b>}{line.text}{'\n'}</span>
	))}</code></pre>
</figure>

<style>
	.kf-term {
		margin: 0;
		border: 1px solid var(--kf-term-border);
		border-radius: 0.75rem;
		background: var(--kf-term-bg);
		overflow: hidden;
		box-shadow: var(--sl-shadow-md);
	}
	.kf-term-bar {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.6rem 0.85rem;
		border-bottom: 1px solid var(--kf-term-border);
	}
	.kf-term-bar span {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: #3a3f47;
	}
	.kf-term-bar em {
		margin-left: 0.5rem;
		font-style: normal;
		font-size: var(--sl-text-xs);
		color: #8b949e;
	}
	pre {
		margin: 0;
		padding: 1rem 1.1rem;
		overflow-x: auto;
		background: transparent;
		border: 0;
		font-size: 0.8rem;
		line-height: 1.6;
		color: var(--kf-term-fg);
	}
	code {
		background: none;
		padding: 0;
		color: inherit;
		font-size: inherit;
	}
	b {
		color: #e8a317;
		font-weight: 600;
	}
	.kf-cmd {
		color: #ffffff;
	}
	.kf-ok {
		color: #56d364;
	}
	.kf-fail {
		color: #ff7b72;
	}
	.kf-fix {
		color: #e8a317;
	}
	.kf-dim {
		color: #8b949e;
	}
</style>
