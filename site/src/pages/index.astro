---
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/sixtyfour/400.css';
import '../styles/landing.css';
import Icon from '../components/Icon.astro';
import Copy from '../components/Copy.astro';
import Term, { type Line } from '../components/Term.astro';

const title = 'Keyfit: the right accounts for every repo';
const description =
	'Keyfit verifies each project’s AWS, Linear, GitHub, Claude, Codex, OpenCode, Copilot CLI, Gemini CLI, Vercel, Supabase, Cloudflare, Convex, Google Cloud and Firebase accounts before your agent runs.';
const repo = 'https://github.com/FlamurMaliqi/keyfit';
// Launch day (KEY-38): set to true once PyPI and the Homebrew tap have Keyfit. Until then the
// install commands stay hidden, so nobody copies `pipx install keyfit` before that name is ours.
const released = false;

// Real Keyfit and CLI output for invented client projects (lumen-web, harbor-api).
const session: Line[] = [
	{ t: 'claude', k: 'cmd' },
	{ t: 'keyfit: claude not started, lumen-web needs attention' },
	{ t: '  ✘ aws        lumen-prod → …8023   SSO session expired', k: 'fail' },
	{ t: '    → aws sso login --sso-session lumen', k: 'fix' },
	{ t: '  (bypass once: KEYFIT_DISABLE=1 claude …)', k: 'dim' },
	{ t: 'aws sso login --sso-session lumen', k: 'cmd' },
	{ t: 'Successfully logged into Start URL: https://lumen.awsapps.com/start', k: 'dim' },
	{ t: 'keyfit status', k: 'cmd' },
	{ t: 'lumen-web' },
	{ t: '  ✔ aws        lumen-prod → …8023   SSO token valid 7h 58m · account confirmed', k: 'ok' },
	{ t: '  ✔ linear     lumen   workspace confirmed', k: 'ok' },
	{ t: '  ✔ github     lumen-ci   login confirmed', k: 'ok' },
	{ t: '  ✔ claude     Lumen   Lumen (team) confirmed', k: 'ok' },
	{ t: '  ✔ opencode   lumen   anthropic signed in · confirmed by OpenCode', k: 'ok' },
	{ t: '  ✔ copilot    lumen-ci   login confirmed', k: 'ok' },
	{ t: '  ✔ gemini     you@lumen.dev   Google sign-in in ~/.config/keyfit/gemini/lumen · confirmed by Google', k: 'ok' },
	{ t: '  ✔ vercel     lumen-ci → lumen   login and team confirmed', k: 'ok' },
	{ t: '  ✔ supabase   Lumen   token and organization confirmed', k: 'ok' },
	{ t: '  ✔ cloudflare lumen → Lumen   bound at ~/code/lumen-web · profile and account confirmed', k: 'ok' },
	{ t: '  ✔ convex     Lumen   login, team and deployment happy-animal-123 (lumen-web) confirmed', k: 'ok' },
	{ t: '  ✔ google     you@lumen.dev', k: 'ok' },
	{ t: '  ✔ gcloud     lumen → lumen-prod   you@lumen.dev · account and project confirmed', k: 'ok' },
	{ t: '  ✔ firebase   lumen-prod   you@lumen.dev, bound at ~/code/lumen-web · account and project confirmed', k: 'ok' },
	{ t: '  ✔ google-mcp gmail_lumen, gcal_lumen   you@lumen.dev · confirmed by Google', k: 'ok' },
	{ t: 'claude', k: 'cmd' },
];

const tools = [
	{ name: 'AWS', logo: 'aws', wide: true },
	{ name: 'Linear', logo: 'linear' },
	{ name: 'GitHub', logo: 'github' },
	{ name: 'Claude Code', logo: 'claude' },
	{ name: 'Codex', logo: 'openai' },
	{ name: 'OpenCode', logo: 'opencode' },
	{ name: 'Copilot CLI', logo: 'copilot' },
	{ name: 'Gemini CLI', logo: 'gemini' },
	{ name: 'Vercel', logo: 'vercel' },
	{ name: 'Supabase', logo: 'supabase' },
	{ name: 'Cloudflare', logo: 'cloudflare' },
	{ name: 'Convex', logo: 'convex' },
	{ name: 'Google Cloud', logo: 'gcloud' },
	{ name: 'Firebase', logo: 'firebase' },
];

const features: { label: string; title: string; text: string; term: string; lines: Line[] }[] = [
	{
		label: 'Verified, not assumed',
		title: 'Checked with each service.',
		text: 'Keyfit asks AWS, Linear, GitHub (for gh and Copilot CLI), Claude, Vercel, Supabase, Cloudflare, Convex and Google (for gcloud, the firebase CLI and Gemini CLI) who you are signed in as, and OpenCode which sign-ins it uses. Expired sign-ins are caught before anything runs.',
		term: '~/code/harbor-api',
		lines: [
			{ t: 'keyfit status', k: 'cmd' },
			{ t: 'harbor-api' },
			{ t: '  ✔ aws        harbor → …4417   IAM key via Granted · account confirmed', k: 'ok' },
			{ t: '  ✔ linear     harbor   workspace confirmed', k: 'ok' },
			{ t: '  ✔ github     harbor-dev   login confirmed', k: 'ok' },
			{ t: '  ✔ codex      ChatGPT pro   subscription login, no API key', k: 'ok' },
		],
	},
	{
		label: 'Wrong account refused',
		title: 'Another client’s profile? Refused.',
		text: 'Inside a project, an AWS profile, Vercel team, Supabase project, Cloudflare account, Convex deployment, Google Cloud project or Firebase project that belongs to another client is blocked, and you see why.',
		term: '~/code/lumen-web',
		lines: [
			{ t: 'aws --profile harbor s3 ls', k: 'cmd' },
			{ t: 'keyfit: this folder belongs to lumen-web (AWS profile lumen-prod); refusing --profile harbor.', k: 'fail' },
			{ t: '  Bypass once: KEYFIT_DISABLE=1 aws …', k: 'dim' },
			{ t: 'vercel deploy --scope harbor', k: 'cmd' },
			{ t: 'keyfit: this folder belongs to lumen-web (Vercel team lumen); refusing --scope harbor.', k: 'fail' },
		],
	},
	{
		label: 'Project-scoped MCP',
		title: 'Each project sees its own servers.',
		text: 'Agents only get the Linear workspace of the repo they are in, and only the Gmail, Drive and Calendar servers signed in as its Google account. MCP servers you claim for one client stay out of every other session.',
		term: 'codex  /mcp',
		lines: [
			{ t: 'linear_lumen:  connected (59 tools)', k: 'ok' },
			{ t: 'gmail_lumen:   connected (19 tools)', k: 'ok' },
			{ t: 'linear_harbor: disabled (0 tools)', k: 'dim' },
			{ t: 'gmail_harbor:  disabled (0 tools)', k: 'dim' },
			{ t: 'harbor_cloud:  disabled (0 tools)', k: 'dim' },
			{ t: 'buffer:        connected (12 tools)', k: 'ok' },
		],
	},
	{
		label: 'No new habits',
		title: 'Keep typing claude.',
		text: 'Keyfit knows the project from the folder, including git worktrees and Superset workspaces. Claude Code, Codex, OpenCode, Copilot CLI and Gemini CLI start with its accounts. Folders you haven’t registered work exactly as before.',
		term: '~/code/harbor-api',
		lines: [
			{ t: 'cd ~/code/harbor-api', k: 'cmd' },
			{ t: 'claude', k: 'cmd' },
			{ t: '' },
			{ t: '  ✻ Welcome to Claude Code', k: 'hi' },
			{ t: '' },
			{ t: '  keyfit · harbor-api · aws harbor → …4417 · linear harbor · github harbor-dev', k: 'dim' },
		],
	},
];

const privacy = [
	{ icon: 'laptop' as const, title: 'No account, no server, no telemetry', text: 'A small open-source command-line tool with no dependencies.' },
	{ icon: 'lockKey' as const, title: 'Keys stay secret', text: 'Never printed or logged. Keys you add are stored in the macOS Keychain.' },
	{ icon: 'globe' as const, title: 'Each key goes only where it belongs', text: 'The Linear key goes to Linear, the GitHub token to GitHub. Nothing else leaves your Mac.' },
	{ icon: 'gitBranch' as const, title: 'Your repositories stay untouched', text: 'Nothing is written into your code or into another tool’s login.' },
];

const faq = [
	{ q: 'Does it slow my tools down?', a: 'Barely. Local checks run on every launch, and online checks are reused for 30 minutes, so most launches add a fraction of a second.' },
	{ q: 'What happens in folders I haven’t registered?', a: 'Nothing. The tools run exactly as they did before Keyfit.' },
	{ q: 'I already use direnv. Do I start over?', a: 'No. keyfit init imports the AWS profile and Linear key lines from your .envrc. It reads the file as text and never runs it.' },
	{ q: 'Does Keyfit see my code or prompts?', a: 'No. It decides which accounts a tool starts with, then hands over to the real tool.' },
	{ q: 'Linux or Windows?', a: 'Not yet. Keys live in the macOS Keychain, so the first version is macOS only. Linux is planned.' },
	{ q: 'How do I turn it off?', a: 'KEYFIT_DISABLE=1 claude skips Keyfit once. keyfit setup --remove takes it out of your shell; your projects stay registered.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://keyfit.dev/" />
		<link rel="canonical" href="https://keyfit.dev/" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="theme-color" content="#111111" />
		<script is:inline>
			// Follow the theme chosen in the docs (Starlight stores it); otherwise the system setting applies.
			try {
				const t = localStorage.getItem('starlight-theme');
				if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
			} catch {}
		</script>
	</head>
	<body>
		<header class="nav">
			<div class="wrap nav-row">
				<a class="brand" href="/" aria-label="Keyfit home">KEYFIT</a>
				<nav aria-label="Main">
					<a href="/docs/quickstart/" class="nav-link">Docs</a>
					<a href="/docs/security/" class="nav-link">Security</a>
					<a href={`${repo}/blob/main/CHANGELOG.md`} class="nav-link">Changelog</a>
					<a href={repo} class="nav-gh" aria-label="Keyfit on GitHub"><Icon name="github" /></a>
					<a href="#install" class="btn btn-light btn-sm">INSTALL <Icon name="download" /></a>
				</nav>
			</div>
		</header>

		<main>
			<section class="hero">
				<div class="wrap hero-inner">
					<a class="pill" href={`${repo}`}>Open source and free to use <Icon name="arrowRight" /></a>
					<h1>
						<span class="h1-line">The Right Accounts.</span>
						<span class="h1-line marked">For Every Repo.<i class="mark tl"></i><i class="mark tr"></i><i class="mark bl"></i><i class="mark br"></i></span>
					</h1>
					<p class="hero-sub">Keyfit verifies each project’s AWS, Linear, GitHub, Claude, Codex, OpenCode, Copilot CLI, Gemini CLI, Vercel, Supabase, Cloudflare, Convex, Google Cloud and Firebase accounts before your agent runs.</p>
					<div class="hero-ctas">
						<a href="#install" class="btn btn-light">Install Keyfit <Icon name="download" /></a>
						<a href={repo} class="btn btn-square" aria-label="Keyfit on GitHub"><Icon name="github" /></a>
					</div>
				</div>
				<div class="wrap hero-shot">
					<Term lines={session} title="~/code/lumen-web" prompt="$" play />
				</div>
			</section>

			<section class="demo" aria-labelledby="demo-title">
				<div class="wrap demo-inner">
					<p class="label">Demo</p>
					<h2 id="demo-title">Two client repos. Each gets only its own accounts.</h2>
					<video
						class="demo-video"
						src="/demo/keyfit-demo.mp4"
						poster="/demo/keyfit-demo.jpg"
						width="1832"
						height="992"
						muted
						loop
						playsinline
						controls
						preload="metadata"
						aria-label="In harbor-api, claude starts with harbor's accounts and sees only harbor's Linear server. In lumen-web, the AWS sign-in has expired: Keyfit does not start Claude, offers the sign-in, then starts it, and Claude sees only lumen's Linear server."
					></video>
					<p class="demo-note">Real Keyfit and Claude Code with two made-up clients. Their AWS and Linear accounts are stand-ins, so signing in needs no browser.</p>
				</div>
			</section>

			<section class="tools" aria-labelledby="tools-title">
				<div class="wrap">
					<h2 id="tools-title" class="tools-title">Works with the tools you already use</h2>
					<ul class="tools-grid">
						{tools.map((tool) => (
							<li>
								<span class:list={['tool-logo', { wide: tool.wide }]} style={`--logo:url(/logos/${tool.logo}.svg)`} />
								<span class="tool-name">{tool.name}</span>
							</li>
						))}
					</ul>
				</div>
			</section>

			{features.map((f, i) => (
				<section class:list={['feature', { flip: i % 2 === 1 }]}>
					<div class="wrap feature-grid">
						<div class="feature-copy">
							<p class="label">{f.label}</p>
							<h3>{f.title}</h3>
							<p class="feature-text">{f.text}</p>
						</div>
						<div class="feature-shot">
							<Term lines={f.lines} title={f.term} />
						</div>
					</div>
				</section>
			))}

			<section class="privacy" aria-labelledby="privacy">
				<div class="wrap">
					<p class="label">Private by design</p>
					<h2 id="privacy">Runs on your Mac. Talks only to the services it checks.</h2>
					<ul class="privacy-grid">
						{privacy.map((p) => (
							<li>
								<Icon name={p.icon} class="privacy-icon" />
								<h3>{p.title}</h3>
								<p>{p.text}</p>
							</li>
						))}
					</ul>
					<a class="text-link" href="/docs/security/">Everything it reads, stores and sends <Icon name="arrowRight" /></a>
				</div>
			</section>

			<section class="install" id="install" aria-labelledby="install-title">
				<div class="wrap install-inner">
					<h2 id="install-title">Set it up once. Then forget about it.</h2>
					<p class="install-req">macOS, Python 3.11 or newer, zsh or bash.</p>
					<div class="install-steps">
						<div>
							<p class="label">Install</p>
							{released ? (
								<>
									<Copy command="brew install flamurmaliqi/keyfit/keyfit" />
									<p class="or">or</p>
									<Copy command="pipx install keyfit" />
								</>
							) : (
								<p class="soon">Available 25 October, with Homebrew and pipx.</p>
							)}
						</div>
						<div>
							<p class="label">Turn it on</p>
							<Copy command="keyfit setup --rc" />
							<Copy command="keyfit init" prompt="~/code/lumen-web $" />
							<p class="install-note">Open a new terminal after <code>setup</code>. <code>init</code> offers the accounts it finds on your Mac.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="faq" aria-labelledby="faq">
				<div class="wrap faq-inner">
					<h2 id="faq">Questions</h2>
					<div class="faq-list">
						{faq.map((f) => (
							<details>
								<summary>{f.q}</summary>
								<p>{f.a}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="foot">
			<div class="wrap foot-grid">
				<div>
					<a class="brand brand-sm" href="/" aria-label="Keyfit home">KEYFIT</a>
					<p class="foot-note">Open source, MIT licensed.</p>
				</div>
				<nav aria-label="Docs">
					<p class="foot-head">Docs</p>
					<a href="/docs/quickstart/">Quickstart</a>
					<a href="/docs/how-it-works/">How it works</a>
					<a href="/docs/commands/">Commands</a>
					<a href="/docs/troubleshooting/">Troubleshooting</a>
				</nav>
				<nav aria-label="Project">
					<p class="foot-head">Project</p>
					<a href={repo}>GitHub</a>
					<a href={`${repo}/blob/main/CHANGELOG.md`}>Changelog</a>
					<a href="/docs/security/">Security</a>
					<a href={`${repo}/blob/main/SECURITY.md`}>Report a vulnerability</a>
				</nav>
			</div>
		</footer>
		<script>
			// The demo plays while it is on screen and pauses when it leaves; with reduced motion it waits for a click.
			const video = document.querySelector<HTMLVideoElement>('.demo-video');
			if (video && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
				new IntersectionObserver(
					([entry]) => (entry.isIntersecting ? video.play().catch(() => {}) : video.pause()),
					{ threshold: 0.6 },
				).observe(video);
			}
		</script>
	</body>
</html>
